import pygame
import random
import time

# 1. 초기 설정
pygame.init()
WIDTH, HEIGHT = 400, 700
screen = pygame.display.set_mode((WIDTH, HEIGHT))
pygame.display.set_caption("Rhythm Game - Extended Cleanup")
clock = pygame.time.Clock()

# 색상 정의
WHITE = (255, 255, 255)
BLACK = (0, 0, 0)
GRAY = (50, 50, 50)
YELLOW = (255, 255, 0)
RED = (255, 0, 0)
DARK_GRAY = (20, 20, 20)
HIT_COLOR = (40, 40, 60)
BTN_COLOR = (70, 70, 70)
BTN_PRESSED = (40, 40, 40)

# 폰트 설정
font_huge = pygame.font.SysFont("malgungothic", 100, bold=True)
font_large = pygame.font.SysFont("malgungothic", 45, bold=True)
font_mid = pygame.font.SysFont("malgungothic", 30, bold=True)
font_small = pygame.font.SysFont("malgungothic", 18)

# 게임 변수
LANE_X = [0, 100, 200, 300]
KEYS = [pygame.K_d, pygame.K_f, pygame.K_j, pygame.K_k]
JUDGE_LINE_Y = HEIGHT - 120
key_status = [False, False, False, False]

notes = [] 
score = 0
lives = 5 
base_speed = 0 
current_speed = 0 
spawn_delay = 0
timer = 0
hit_feedback_timer = 0
practice_mode = False

def reset_game(diff, is_practice=False):
    global notes, score, lives, base_speed, current_speed, spawn_delay, timer, practice_mode
    notes, score, lives, timer = [], 0, 5, 0
    practice_mode = is_practice
    if diff == 1: base_speed, spawn_delay = 7, 35
    elif diff == 2: base_speed, spawn_delay = 10, 28
    else: base_speed, spawn_delay = 13, 20
    current_speed = base_speed

def draw_background():
    screen.fill(HIT_COLOR if hit_feedback_timer > 0 else BLACK)
    for x in LANE_X: pygame.draw.line(screen, GRAY, (x, 0), (x, HEIGHT), 1)
    pygame.draw.line(screen, YELLOW, (0, JUDGE_LINE_Y), (WIDTH, JUDGE_LINE_Y), 4)
    for i in range(4):
        rect_color = (80, 80, 80) if key_status[i] else DARK_GRAY
        pygame.draw.rect(screen, rect_color, (LANE_X[i] + 2, HEIGHT - 118, 96, 118))
    
    if not practice_mode:
        for i in range(5):
            circle_color = RED if i < lives else GRAY
            pygame.draw.circle(screen, circle_color, (30 + (i * 30), 35), 10, 0 if i < lives else 2)
    else:
        practice_txt = font_small.render("PRACTICE MODE (IMMORTAL)", True, YELLOW)
        screen.blit(practice_txt, (15, 25))

    score_text = font_small.render(f"Score: {score} | Speed: {current_speed:.1f}", True, WHITE)
    screen.blit(score_text, (15, 65))

def draw_notes():
    for note in notes:
        pygame.draw.rect(screen, WHITE, (LANE_X[note[0]] + 4, note[1], 92, note[2]), border_radius=5)

def clear_danger_notes():
    """연속 미스 방지를 위해 판정선 위/아래의 위험 범위를 싹 지웁니다."""
    global notes
    # 타일의 끝부분(note[1] + note[2])이 판정선(JUDGE_LINE_Y)보다 '100px 위'에 있는 것들만 남깁니다.
    # 즉, 판정선에 닿기 직전의 타일까지 넉넉하게 지워버립니다. (50 -> 100으로 상향)
    notes = [note for note in notes if (note[1] + note[2]) < JUDGE_LINE_Y - 100]

def show_miss_effect():
    # 미스 즉시 위험 범위 타일 삭제
    clear_danger_notes()
    
    overlay = pygame.Surface((WIDTH, HEIGHT))
    overlay.set_alpha(150); overlay.fill(RED)
    
    # 붉은 레이어 1초 정지
    draw_background(); draw_notes()
    screen.blit(overlay, (0, 0)); pygame.display.flip()
    time.sleep(1) 
    
    # 카운트다운 3초
    for i in range(3, 0, -1):
        draw_background(); draw_notes()
        txt = font_huge.render(str(i), True, YELLOW)
        screen.blit(txt, (WIDTH // 2 - txt.get_width() // 2, HEIGHT // 2 - 100))
        pygame.display.flip(); time.sleep(1)
    
    # 정지/카운트다운 중 입력된 이벤트들을 완전히 비워서 재시작 시 오작동 방지
    pygame.event.clear()

def draw_button(rect, text, is_pressed):
    offset = 4 if is_pressed else 0
    shadow_rect = rect.copy()
    main_rect = pygame.Rect(rect.x, rect.y + offset, rect.width, rect.height)
    pygame.draw.rect(screen, (30, 30, 30), shadow_rect, border_radius=40)
    pygame.draw.rect(screen, BTN_PRESSED if is_pressed else BTN_COLOR, main_rect, border_radius=40)
    pygame.draw.rect(screen, WHITE, main_rect, 2, border_radius=40)
    txt = font_mid.render(text, True, WHITE)
    screen.blit(txt, (main_rect.centerx - txt.get_width()//2, main_rect.centery - txt.get_height()//2))

scene = "START"
pressed_btn_idx = -1

while True:
    if scene == "START":
        screen.fill(BLACK)
        title = font_large.render("난이도 선택", True, WHITE)
        screen.blit(title, (WIDTH // 2 - title.get_width() // 2, 50))
        buttons = [pygame.Rect(WIDTH // 2 - 120, 150 + (i * 110), 240, 80) for i in range(3)]
        practice_btn = pygame.Rect(WIDTH // 2 - 120, 500, 240, 80)
        for i, btn in enumerate(buttons):
            draw_button(btn, f"{i+1} 단계", pressed_btn_idx == i)
        draw_button(practice_btn, "연습 게임", pressed_btn_idx == 3)

        for event in pygame.event.get():
            if event.type == pygame.QUIT: pygame.quit(); exit()
            if event.type == pygame.MOUSEBUTTONDOWN:
                for i, btn in enumerate(buttons):
                    if btn.collidepoint(event.pos): pressed_btn_idx = i
                if practice_btn.collidepoint(event.pos): pressed_btn_idx = 3
            if event.type == pygame.MOUSEBUTTONUP:
                if pressed_btn_idx != -1:
                    if pressed_btn_idx < 3: reset_game(pressed_btn_idx + 1); scene = "PLAYING"
                    else: reset_game(2, True); scene = "PLAYING"
                    pressed_btn_idx = -1

    elif scene == "PLAYING":
        draw_background()
        draw_notes()
        if hit_feedback_timer > 0: hit_feedback_timer -= 1
        current_speed += 0.0015 

        miss_triggered = False 
        
        for event in pygame.event.get():
            if event.type == pygame.QUIT: pygame.quit(); exit()
            if event.type == pygame.KEYDOWN:
                if event.key == pygame.K_SPACE: scene = "START"
                hit_success = False
                for i in range(4):
                    if event.key == KEYS[i]:
                        key_status[i] = True
                        for note in notes[:]:
                            # 판정선 근처 타격 감지
                            if note[0] == i and note[1] < JUDGE_LINE_Y + 20 and (note[1] + note[2]) > JUDGE_LINE_Y - 30:
                                notes.remove(음표); score += 10; hit_success = True; hit_feedback_timer = 5; break
                        if not hit_success:
                            if not practice_mode: lives -= 1
                            miss_triggered = True 
                if lives <= 0: scene = "GAMEOVER"
            if event.type == pygame.KEYUP:
                for i in range(4):
                    if event.key == KEYS[i]: key_status[i] = False

        # 노트 생성
        timer += 1
        if timer >= spawn_delay + random.randint(-5, 5):
            note_height = int(random.triangular(60, 160, 100))
            lane = random.randint(0, 3)
            notes.append([lane, -note_height, note_height])
            if score > 50 and random.random() < 0.2:
                notes.append([(lane + random.randint(1, 3)) % 4, -note_height, note_height])
            timer = 0

        # 이동 및 놓침 체크
        for note in notes[:]:
            note[1] += current_speed 
            if note[1] > JUDGE_LINE_Y: 
                if not practice_mode: lives -= 1
                miss_triggered = True
                if lives <= 0: scene = "GAMEOVER"

        # 미스 연출 (여기서 100px 삭제 로직이 작동함)
        if miss_triggered and scene == "PLAYING":
            show_miss_effect()

    elif scene == "GAMEOVER":
        screen.fill(BLACK)
        over_txt = font_large.render("GAME OVER", True, RED)
        home_btn = pygame.Rect(WIDTH // 2 - 120, HEIGHT // 2 + 100, 240, 60)
        draw_button(home_btn, "메인 화면", False)
        screen.blit(over_txt, (WIDTH // 2 - over_txt.get_width() // 2, HEIGHT // 2 - 80))
        for event in pygame.event.get():
            if event.type == pygame.QUIT: pygame.quit(); exit()
            if event.type == pygame.KEYDOWN and event.key == pygame.K_SPACE: scene = "START"
            if event.type == pygame.MOUSEBUTTONDOWN:
                if home_btn.collidepoint(event.pos): scene = "START"

    pygame.display.flip()
    clock.tick(60)
